# .gitignore
# ============================================================
#  HelloAgents Trip Planner — Root-level ignores
# ============================================================

# 环境变量（含密钥）
.env
.env.local
.env.*.local

# 会话记忆（本地的，不提交）
memory/

# 问题追踪记录（本地工作笔记）
problem_record

# 依赖
node_modules/
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# 构建产物
dist/
build/
*.egg-info/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# 日志
*.log
logs/

# 临时文件
tmp/
temp/
*.tmp

# 上传目录
uploads/
